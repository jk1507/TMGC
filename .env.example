# ============================================
# RETRO_INTEL — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Gemini AI (Google) ---
# Get your key at: https://aistudio.google.com/apikey
# Only needed if you do NOT run a local LLM (or as a fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Local LLM (Ollama / LM Studio / llama.cpp) ---
# Used FIRST for AI reports so analysis works fully offline.
# Install Ollama (https://ollama.com) then: ollama pull qwen2.5:3b
LOCAL_LLM_ENABLED=true
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_TIMEOUT=7.0

# --- Threat Intelligence API Keys (Optional) ---
# These are optional — the system works without them
# but threat intel feeds will be disabled

# Google Safe Browsing (v4)
# Get key at: https://console.cloud.google.com/apis/credentials
GOOGLE_SAFE_BROWSING_KEY=

# VirusTotal
# Get key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# PhishTank
# Get key at:phishtank.org/developerinfo.php
PHISHTANK_API_KEY=

# AbuseIPDB
# Get key at: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# urlscan.io
# Get key at: https://urlscan.io/user/apikeys/
URLSCAN_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=200

# --- CORS ---
# Comma-separated allowed origins for frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Proxy (Optional) ---
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080

# --- Frontend API URL ---
# For production, set this to your backend URL
VITE_API_URL=http://localhost:8000/api/v1/analyze
VITE_AI_ANALYSIS_API=http://localhost:8000/api/v1/ai-analysis
