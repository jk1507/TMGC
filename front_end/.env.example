# Frontend Environment Variables
# Copy this file to .env.local and update values for your environment

# Backend API URL (must include /api/v1/analyze endpoint)
VITE_API_URL=http://localhost:8000/api/v1/analyze

# AI Analysis API URL (must include /api/v1/ai-analysis endpoint)
VITE_AI_ANALYSIS_API=http://localhost:8000/api/v1/ai-analysis